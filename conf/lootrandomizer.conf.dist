[worldserver]

###################################################################################################
# mod-lootrandomizer
#
# RandomLoot.Enable
#     Enables or disables the entire module.
# Default: 0 (disabled)
###################################################################################################
RandomLoot.Enable = 0

###################################################################################################
# Account exclusions
#
# RandomLoot.Account.ExcludeIds
#     Comma-separated list of account IDs to exclude from random loot entirely.
#     Example: 2,5,7
# Default: "" (no exclusions)
#
# RandomLoot.Account.ExcludeRange
#     Inclusive comma-separated account ID range to exclude from random loot.
#     Example: 1000,1377 excludes account IDs 1000 through 1377, including both endpoints.
#     Leave empty to disable range exclusion. The first ID must not be greater than the second.
# Default: "" (no range exclusion)
#
# RandomLoot.Account.AllowRandomLootWhenGrouped
#     Allows an excluded killer to generate random loot while they are in a group.
#     Intended for playerbots grouped with real players, so a playerbot killing blow does not
#     suppress random loot for the group.
# Default: 0 (excluded killers never generate random loot)
###################################################################################################
RandomLoot.Account.ExcludeIds =
RandomLoot.Account.ExcludeRange =
RandomLoot.Account.AllowRandomLootWhenGrouped = 0

###################################################################################################
# Chance by creature level (percent chance per kill)
#
# Add only the level keys that should start a new chance bracket, from 1 through 80.
# If a creature level does not have an exact key, it uses the closest lower configured level.
# Example: with only Level.1 and Level.80 configured, levels 1-79 use Level.1's chance.
# A creature below the lowest configured key has a 0% chance. Keep Level.1 to define a baseline.
# Missing keys are valid and do not disable the module.
###################################################################################################
RandomLoot.Chance.Level.1 = 25
RandomLoot.Chance.Level.60 = 30
RandomLoot.Chance.Level.70 = 35
RandomLoot.Chance.Level.80 = 40

###################################################################################################
# How many random items can be added on a successful roll
###################################################################################################
RandomLoot.MinItems = 1
RandomLoot.MaxItems = 1

###################################################################################################
# Item filtering
#
# For range settings below, a value of 0 means "no limit" for that side of the range.
###################################################################################################

# Inclusive eligible item-type filter (OR semantics)
#
# If disabled (0): no item-type filtering is applied.
# If enabled (1): any item matching at least one Include.* key set to 1 is eligible.
# This is intentionally non-exclusionary: enabling Rings and Weapons means "rings OR weapons".
RandomLoot.Filter.TypeFilterEnabled = 1

# Broad class groups
RandomLoot.Filter.Include.Weapons = 1
RandomLoot.Filter.Include.Armor = 1
RandomLoot.Filter.Include.Consumables = 1
RandomLoot.Filter.Include.Containers = 1
RandomLoot.Filter.Include.Gems = 1
RandomLoot.Filter.Include.Reagents = 1
RandomLoot.Filter.Include.Projectiles = 1
RandomLoot.Filter.Include.TradeGoods = 1
RandomLoot.Filter.Include.Recipes = 1
RandomLoot.Filter.Include.Quivers = 1
RandomLoot.Filter.Include.Quest = 0
RandomLoot.Filter.Include.Keys = 0
RandomLoot.Filter.Include.Misc = 1
RandomLoot.Filter.Include.Glyphs = 1

# Slot/equipment family groups
RandomLoot.Filter.Include.Jewelry = 1
RandomLoot.Filter.Include.Rings = 1
RandomLoot.Filter.Include.Necklaces = 1
RandomLoot.Filter.Include.Trinkets = 1
RandomLoot.Filter.Include.Cloaks = 1
RandomLoot.Filter.Include.Shields = 1
RandomLoot.Filter.Include.Relics = 1
RandomLoot.Filter.Include.Holdables = 1
RandomLoot.Filter.Include.Bags = 1
RandomLoot.Filter.Include.Tabards = 1
RandomLoot.Filter.Include.Shirts = 1

RandomLoot.Filter.Include.Head = 1
RandomLoot.Filter.Include.Shoulders = 1
RandomLoot.Filter.Include.Chest = 1
RandomLoot.Filter.Include.Waist = 1
RandomLoot.Filter.Include.Legs = 1
RandomLoot.Filter.Include.Feet = 1
RandomLoot.Filter.Include.Wrists = 1
RandomLoot.Filter.Include.Hands = 1

RandomLoot.Filter.Include.OneHandWeapons = 1
RandomLoot.Filter.Include.TwoHandWeapons = 1
RandomLoot.Filter.Include.RangedWeapons = 1

# Item quality filter (per-option)
# If FilterEnabled = 0, quality is not filtered.
RandomLoot.Filter.Quality.FilterEnabled = 1
RandomLoot.Filter.Quality.Include.Poor = 0
RandomLoot.Filter.Quality.Include.Common = 1
RandomLoot.Filter.Quality.Include.Uncommon = 1
RandomLoot.Filter.Quality.Include.Rare = 1
RandomLoot.Filter.Quality.Include.Epic = 1
RandomLoot.Filter.Quality.Include.Legendary = 1
RandomLoot.Filter.Quality.Include.Artifact = 1
RandomLoot.Filter.Quality.Include.Heirloom = 1

# Required level range (set Min or Max to 0 to disable that limit)
RandomLoot.Filter.RequiredLevel.Min = 0
RandomLoot.Filter.RequiredLevel.Max = 0

# Item level range (set Min or Max to 0 to disable that limit)
RandomLoot.Filter.ItemLevel.Min = 0
RandomLoot.Filter.ItemLevel.Max = 0

###################################################################################################
# Companion loot
#
# Pets and mounts are removed from the normal random-loot pool and rolled independently for each
# eligible kill. Pets include the standard Class=15, SubClass=2 items and legacy items whose use
# spell summons a pet. Mounts include standard Class=15, SubClass=5 items and legacy items whose use
# spell applies the mounted aura.
# They ignore required-level, item-level, and player-level bracket filters, but still obey the other
# configured filters. When type filtering is enabled, RandomLoot.Filter.Include.Misc must be enabled
# for companions to be eligible. Other miscellaneous subclasses remain in the normal loot pool.
#
# Chance is a percentage rolled once per eligible kill for each companion category. Normal items use
# RandomLoot.Chance.Level.* separately. At most one pet and one mount can be added, subject to the
# corpse's normal loot-slot limit.
###################################################################################################
RandomLoot.Companion.Pets.Enabled = 1
RandomLoot.Companion.Pets.Chance = 2.0
RandomLoot.Companion.Mounts.Enabled = 1
RandomLoot.Companion.Mounts.Chance = 2.0

###################################################################################################
# Player-level item bracket
#
# When enabled, normal items must be within the bracket for the player receiving random loot:
#   MinMaxItemLevel.<max(1, player level - UpperLevelOffset)>.min <= ItemLevel
#       <= MinMaxItemLevel.<min(80, player level + UpperLevelOffset)>.max
# The character-level boundaries are capped at 1 and 80. Existing static filters remain additional
# restrictions.
#
# RandomLoot.Filter.PlayerLevelBracket.BracketEquippableOnly
#     If 1, the dynamic player-level bracket applies only to items with non-zero InventoryType.
#     Normal non-equipment items bypass this dynamic bracket but still obey all static filters.
# Default: 1 (bracket only equippable items)
#
# Each MinMaxItemLevel mapping uses `minimum,maximum`. All 80 mappings are required when enabled.
# Missing, malformed, invalid, or empty ranges fail closed: no random loot is added until corrected.
###################################################################################################
RandomLoot.Filter.PlayerLevelBracket.Enabled = 1
RandomLoot.Filter.PlayerLevelBracket.UpperLevelOffset = 5
RandomLoot.Filter.PlayerLevelBracket.BracketEquippableOnly = 1

# Explicit item-level floor and ceiling by character level. Each entry uses `minimum,maximum`.
# Maximums are cumulative weapon-and-armor ceilings derived from required-level data. Test,
# developer, and reputation-gated templates are excluded, so a ceiling never decreases as levels rise.
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.1 = 1,10
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.2 = 2,11
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.3 = 3,12
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.4 = 4,13
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.5 = 5,14
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.6 = 6,15
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.7 = 7,16
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.8 = 8,17
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.9 = 9,18
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.10 = 10,19
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.11 = 11,20
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.12 = 12,21
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.13 = 13,22
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.14 = 14,24
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.15 = 15,25
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.16 = 16,26
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.17 = 17,27
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.18 = 18,28
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.19 = 19,29
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.20 = 20,30
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.21 = 21,31
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.22 = 22,32
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.23 = 23,33
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.24 = 24,34
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.25 = 25,35
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.26 = 26,36
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.27 = 27,36
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.28 = 28,37
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.29 = 29,37
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.30 = 30,40
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.31 = 31,40
