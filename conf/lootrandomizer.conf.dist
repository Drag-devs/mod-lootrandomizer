# Expansion filter using derived bracket from RequiredLevel:
#   Classic (<= 60), TBC (61-70), Wrath (71+)
RandomLoot.Filter.Expansion.FilterEnabled = 0
RandomLoot.Filter.Expansion.Include.Classic = 1
RandomLoot.Filter.Expansion.Include.TBC = 1
RandomLoot.Filter.Expansion.Include.Wrath = 1

# Bonding filter (per-option)
RandomLoot.Filter.Bonding.FilterEnabled = 0
RandomLoot.Filter.Bonding.Include.NoBind = 1
RandomLoot.Filter.Bonding.Include.BindOnPickup = 1
RandomLoot.Filter.Bonding.Include.BindOnEquip = 1
RandomLoot.Filter.Bonding.Include.BindOnUse = 1
RandomLoot.Filter.Bonding.Include.QuestItem = 1
RandomLoot.Filter.Bonding.Include.QuestItemUnused = 1

# Random loot is additive: it is appended and never replaces normal loot.
# If 1, random loot is only added when the creature already had base loot/money.
# If 0, random loot can also appear on creatures that had no base loot.
RandomLoot.Filter.RequireExistingLoot = 0

###################################################################################################
# Optional numeric reference (AzerothCore enums)
#
# Item quality (RandomLoot.Filter.Quality.Include.*)
#   0=Poor, 1=Common, 2=Uncommon, 3=Rare, 4=Epic, 5=Legendary, 6=Artifact, 7=Heirloom
#
# Inventory type (item_template.InventoryType)
#   0=NonEquip, 1=Head, 2=Neck, 3=Shoulders, 4=Shirt, 5=Chest, 6=Waist, 7=Legs,
#   8=Feet, 9=Wrists, 10=Hands, 11=Finger, 12=Trinket, 13=Weapon, 14=Shield,
#   15=Ranged, 16=Cloak, 17=2HWeapon, 18=Bag, 19=Tabard, 20=Robe,
#   21=MainHand, 22=OffHand, 23=Holdable, 24=Ammo, 25=Thrown, 26=RangedRight,
#   27=Quiver, 28=Relic
#
# Item bonding (RandomLoot.Filter.Bonding.Include.*)
#   0=NoBind, 1=BindOnPickup, 2=BindOnEquip, 3=BindOnUse, 4=QuestItem, 5=QuestItemUnused
#
# Expansion bracket (RandomLoot.Filter.Expansion.Include.* derived from RequiredLevel)
#   Classic (<=60), TBC (61-70), Wrath (71+)
###################################################################################################
