RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.56 = 56,63
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.57 = 57,84
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.58 = 58,84
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.59 = 59,87
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.60 = 60,100
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.61 = 80,100
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.62 = 85,127
