RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.41 = 41,50
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.42 = 42,50
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.43 = 43,50
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.44 = 44,50
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.45 = 45,55
RandomLoot.Filter.PlayerLevelBracket.MinMaxItemLevel.46 = 46,55
